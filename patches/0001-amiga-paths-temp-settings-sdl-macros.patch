diff --git a/src/ppui/osinterface/posix/PPPath_POSIX.cpp b/src/ppui/osinterface/posix/PPPath_POSIX.cpp
index d5597bb..dd170ca 100644
--- a/src/ppui/osinterface/posix/PPPath_POSIX.cpp
+++ b/src/ppui/osinterface/posix/PPPath_POSIX.cpp
@@ -31,12 +31,32 @@
 #include "PPPath_POSIX.h"
 #include <sys/stat.h>
 #include <limits.h>
+#include <string.h>
 
 #ifdef __PSP__
 // Needed for PATH_MAX
 #include <sys/syslimits.h>
 #endif
 
+#ifdef __amigaos__
+// AmigaDOS paths (Work:Music/): GFAmigaMilkyTracker's compat/amiga_path.c
+#include "amiga_path.h"
+
+static PPSystemString amiga_step(const PPSystemString& path, int how)
+{
+	char buf[1024];
+	strncpy(buf, path, sizeof(buf) - 2);
+	buf[sizeof(buf) - 2] = 0;
+	if (how == 0)
+		amiga_path_drawer(buf, sizeof(buf));
+	else if (how == 1)
+		amiga_path_parent(buf);
+	else
+		amiga_path_root(buf, sizeof(buf));
+	return PPSystemString(buf);
+}
+#endif
+
 #ifdef PATH_MAX
 #define PPMAX_DIR_PATH PATH_MAX
 #else
@@ -108,15 +128,23 @@ const PPSystemString PPPath_POSIX::getCurrent()
 
 	PPSystemString path(cwd);
 	
+#ifdef __amigaos__
+	return amiga_step(path, 0);
+#else
 	path.ensureTrailingCharacter(getPathSeparatorAsASCII());
 	return path;
+#endif
 }
 	
 bool PPPath_POSIX::change(const PPSystemString& path)
 {
 	PPSystemString old = current;
+#ifdef __amigaos__
+	current = amiga_step(path, 0);
+#else
 	current = path;
 	current.ensureTrailingCharacter(getPathSeparatorAsASCII());
+#endif
 	bool res = updatePath();
 	if (res)
 		return true;
@@ -184,7 +212,11 @@ bool PPPath_POSIX::canGotoRoot() const
 
 void PPPath_POSIX::gotoRoot()
 {
+#ifdef __amigaos__
+	change(amiga_step(current, 2));
+#else
 	change("/");
+#endif
 	updatePath();
 }
 
@@ -195,7 +227,11 @@ bool PPPath_POSIX::canGotoParent() const
 
 void PPPath_POSIX::gotoParent()
 {
+#ifdef __amigaos__
+	change(amiga_step(current, 1));
+#else
 	stepInto("..");
+#endif
 }
 
 char PPPath_POSIX::getPathSeparatorAsASCII() const
