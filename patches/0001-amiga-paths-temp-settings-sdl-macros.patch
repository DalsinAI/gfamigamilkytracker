@@ -82,11 +88,17 @@ const SYSCHAR* System::getTempFileName()
 			strcpy(buffer, "milkytracker_temp");
 	}
 	return buffer;
+#endif
 }
 
 const SYSCHAR* System::getConfigFileName()
 {
-#ifdef __HAIKU__
+#if defined(__amigaos__)
+	// the settings stay with the program, in PROGDIR:User/
+	mkdir("PROGDIR:User", S_IRWXU);
